/*
Light theme stylesheet for Lab Automation application.

This stylesheet provides a clean, light theme for the PyQt6 application
with modern appearance and good readability.
*/

/* Main application window and widgets */
QWidget {
    background-color: #ffffff;
    color: #2c3e50;
    font-family: "Segoe UI", Arial, sans-serif;
}

/* Tab widget styling */
QTabWidget::pane {
    border: 1px solid #bdc3c7;
    background-color: #ffffff;
}

QTabWidget::tab-bar {
    alignment: left;
}

QTabBar::tab {
    background: #ecf0f1;
    color: #2c3e50;
    border: 1px solid #bdc3c7;
    padding: 8px 12px;
    margin-right: 2px;
    border-bottom: none;
}

QTabBar::tab:selected {
    background: #ffffff;
    border-bottom-color: #ffffff;
}

QTabBar::tab:hover {
    background: #d5dbdb;
}

/* Menu bar styling */
QMenuBar {
    background-color: #f8f9fa;
    color: #2c3e50;
    border-bottom: 1px solid #bdc3c7;
}

QMenuBar::item {
    padding: 4px 8px;
    background: transparent;
}

QMenuBar::item:selected {
    background: #e9ecef;
}

/* Menu styling */
QMenu {
    background-color: #ffffff;
    color: #2c3e50;
    border: 1px solid #bdc3c7;
}

QMenu::item {
    padding: 4px 20px;
}

QMenu::item:selected {
    background: #2271b3;
    color: #ffffff;
}

/* Button styling */
QPushButton {
    background-color: #2271b3;
    color: #ffffff;
    border: 1px solid #1c5f96;
    padding: 6px 12px;
    border-radius: 4px;
}

QPushButton:hover {
    background-color: #1c5f96;
}

QPushButton:pressed {
    background-color: #21618c;
}

QPushButton:disabled {
    background-color: #d5dadd;
    color: #4d5963;
    border: 1px solid #95a5a6;
}

/* Line edit styling */
QLineEdit {
    background-color: #ffffff;
    color: #2c3e50;
    border: 1px solid #bdc3c7;
    padding: 4px 8px;
    border-radius: 4px;
    placeholder-text-color: #6b7580;
}

QLineEdit:focus {
    border: 2px solid #2271b3;
}

/* Combo box styling */
QComboBox {
    background-color: #ffffff;
    color: #2c3e50;
    border: 1px solid #bdc3c7;
    padding: 4px 8px;
    border-radius: 4px;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox::down-arrow {
    image: url("@ICONS@/arrow_down_light.svg");
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #2c3e50;
    selection-background-color: #2271b3;
    selection-color: #ffffff;
}

/* List widget styling */
QListWidget {
    background-color: #ffffff;
    color: #2c3e50;
    border: 1px solid #bdc3c7;
}

QListWidget::item {
    padding: 4px 8px;
    border-bottom: 1px solid #ecf0f1;
}

QListWidget::item:selected {
    background-color: #2271b3;
    color: #ffffff;
}

QListWidget::item:hover {
    background-color: #ebf3fd;
}

/* Table widget styling */
QTableWidget {
    background-color: #ffffff;
    color: #2c3e50;
    border: 1px solid #bdc3c7;
    gridline-color: #ecf0f1;
}

QTableWidget::item {
    padding: 4px 8px;
    border-bottom: 1px solid #ecf0f1;
}

QTableWidget::item:selected {
    background-color: #2271b3;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #f8f9fa;
    color: #2c3e50;
    padding: 6px 8px;
    border: 1px solid #bdc3c7;
}

/* Scroll bar styling */
QScrollBar:vertical {
    background: #f8f9fa;
    width: 14px;
    border: none;
}

QScrollBar::handle:vertical {
    background: #7d8a97;
    border-radius: 7px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #5f6b78;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #f8f9fa;
    height: 14px;
    border: none;
}

QScrollBar::handle:horizontal {
    background: #7d8a97;
    border-radius: 7px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background: #5f6b78;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* Group box styling */
QGroupBox {
    color: #2c3e50;
    border: 1px solid #bdc3c7;
    border-radius: 4px;
    margin-top: 10px;
    padding-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px 0 5px;
}

/* Text edit styling */
QTextEdit {
    background-color: #ffffff;
    color: #2c3e50;
    border: 1px solid #bdc3c7;
    border-radius: 4px;
}

/* Spin box styling */
QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    color: #2c3e50;
    border: 1px solid #bdc3c7;
    padding: 4px 8px;
    border-radius: 4px;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border: 2px solid #2271b3;
}

QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    width: 18px;
    border: none;
    background: transparent;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url("@ICONS@/arrow_up_light.svg");
    width: 10px;
    height: 10px;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url("@ICONS@/arrow_down_light.svg");
    width: 10px;
    height: 10px;
}

/* Check box styling */
QCheckBox {
    color: #2c3e50;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #bdc3c7;
    border-radius: 2px;
    background-color: #ffffff;
}

QCheckBox::indicator:checked {
    background-color: #2271b3;
    border: 1px solid #2271b3;
    image: url("@ICONS@/check_light.svg");
}

/* Radio button styling */
QRadioButton {
    color: #2c3e50;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #bdc3c7;
    border-radius: 8px;
    background-color: #ffffff;
}

QRadioButton::indicator:checked {
    background-color: #2271b3;
    border: 1px solid #2271b3;
}

/* Status bar styling */
QStatusBar {
    background-color: #f8f9fa;
    color: #2c3e50;
    border-top: 1px solid #bdc3c7;
}
/* ===== MEASUREMENT LABELS ===== */
QLabel[class="measurement"] {
    background-color: #ffffff;
    color: #2c3e50;
    border: 2px solid #bdc3c7;
    padding: 8px;
    margin: 2px;
    border-radius: 6px;
    font-family: 'Courier New', monospace;
    font-size: 12px;
    min-width: 150px;
    font-weight: 600;
}

QLabel[class="measurement"][state="error"] {
    background-color: #ffe6e6;
    color: #b3261e;
    border: 2px solid #e74c3c;
}

QLabel[class="measurement"][state="normal"] {
    background-color: #e6ffe6;
    color: #1b6e3a;
    border: 2px solid #2271b3;
}

/* ===== WIDGET NELLE TABELLE ===== */
QTableWidget {
    gridline-color: #ecf0f1;
}

QTableWidget QLineEdit {
    min-height: 0;
    min-width: 0;
    padding: 2px 4px;
    font-size: 10px;
}

QTableWidget QComboBox {
    min-height: 0;
    min-width: 0;
    padding: 2px 4px;
    font-size: 10px;
}

QTableWidget QCheckBox {
    padding: 2px;
    min-height: 0;
    min-width: 0;
}

/* ===== INFO TEXT (instead of colours written in the code) ===== */
QLabel[class="infobox"] {
    background-color: #e3f2fd;
    color: #2c3e50;
    padding: 8px 10px;
    border-radius: 5px;
}

QLabel[class="accent"] {
    color: #0b6bb5;
    padding: 4px 2px;
}

QLabel[class="muted"] {
    color: #5f6b76;
    padding: 4px 2px;
}

QLabel[class="error"] {
    color: #b00020;
}

QLabel[class="ok"] {
    color: #2e7d32;
}

QLabel[class="warning"] {
    color: #8a5200;
}

QPushButton[class="action"] {
    padding: 10px 12px;
    font-weight: bold;
}

/* a table whose cells hold widgets: they fill the cell (the padding of the items would shrink them) */
QTableWidget[class="widgetcells"]::item {
    padding: 0px;
}
